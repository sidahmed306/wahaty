# Copier ce fichier en `.env` et remplir les valeurs. Ne jamais mettre `.env` dans Git.
SECRET_KEY=a-remplacer-par-une-longue-cle-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de la plateforme : Neon (Console Neon > Connect > Pooled connection)
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Base des tests automatiques : PostgreSQL local (Postgres.app)
TEST_DATABASE_URL=postgres://admin@localhost:5432/wahaty

# Photos chez Cloudinary (Console Cloudinary > Settings > API Keys > « API environment variable »).
# Format : cloudinary://CLE_API:SECRET_API@NOM_DU_COMPTE   (laisser vide en local : dossier media/)
CLOUDINARY_URL=

# Production seulement (Render) : adresses du site autorisées à appeler l'API
# CORS_ALLOWED_ORIGINS=https://trc.pages.dev
# CSRF_TRUSTED_ORIGINS=https://trc-api.onrender.com
# JWT_REFRESH_DAYS=30
